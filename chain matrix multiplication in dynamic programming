#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int matrixChainMultiplication(vector<int>& p) {
    int n = p.size() - 1;

    // dp[i][j] = minimum cost to multiply matrices i to j
    vector<vector<int>> dp(n + 1, vector<int>(n + 1, 0));

    // length is the chain length
    for (int length = 2; length <= n; length++) {

        for (int i = 1; i <= n - length + 1; i++) {

            int j = i + length - 1;
            dp[i][j] = INT_MAX;

            // Try every possible split
            for (int k = i; k < j; k++) {

                int cost = dp[i][k]
                         + dp[k + 1][j]
                         + p[i - 1] * p[k] * p[j];

                dp[i][j] = min(dp[i][j], cost);
            }
        }
    }

    return dp[1][n];
}

int main() {
    // A1 = 10x20
    // A2 = 20x30
    // A3 = 30x40
    vector<int> p = {10, 20, 30, 40};

    cout << "Minimum number of multiplications = "
         << matrixChainMultiplication(p);

    return 0;
}
